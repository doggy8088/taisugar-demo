@model ListModel
@{ViewData["Title"]=Model.Module.Title;var m=Model.Module;string Link(int page)=>Url.Action("Index","Manage",new{module=m.Key,q=Model.Q,status=Model.Status,sort=Model.Sort,size=Model.Size,page})!;}
<section class="page-heading"><div><div class="eyebrow">PROPERTY OPERATIONS</div><h1>@(m.Title)</h1><p>@(m.Description)</p></div><a class="button primary" href="/manage/@(m.Key)/create"><span>＋</span> 新增@(m.Singular)</a></section>
@if(m.Key=="invoices"){
<form method="post" action="/manage/invoices/generate" class="billing-banner">@Html.AntiForgeryToken()<div><strong>每月租金，一次完成出帳</strong><small>依有效租約產生應收，重複帳款將自動略過。</small></div><label class="sr-only" for="billing-month">出帳月份</label><input id="billing-month" type="month" name="month" value="@Business.Today.ToString("yyyy-MM")" required/><button class="button secondary" type="submit">產生租金應收 <span>↗</span></button></form>
}
<section class="panel">
<div class="panel-heading"><h2>@(m.Singular)清單 <span class="count">@Model.Total</span></h2><span class="muted">集中管理 · 即時更新</span></div>
<form method="get" class="filters" action="/manage/@(m.Key)">
<div class="search-field"><svg><use href="#i-search"/></svg><label class="sr-only" for="q">搜尋編號、名稱或備註</label><input id="q" name="q" value="@Model.Q" placeholder="搜尋編號、名稱或備註…" maxlength="200"/></div>
<label class="sr-only" for="status">篩選狀態</label><select id="status" name="status"><option value="">全部狀態</option>@foreach(var s in m.States){<option value="@s" selected="@(Model.Status==s)">@s</option>}</select>
<label class="sr-only" for="sort">排序方式</label><select id="sort" name="sort"><option value="code" selected="@(Model.Sort=="code")">編號排序</option><option value="name" selected="@(Model.Sort=="name")">名稱排序</option><option value="updated" selected="@(Model.Sort=="updated")">最近更新</option></select>
<input type="hidden" name="size" value="@Model.Size"/><button type="submit" class="button secondary">查詢</button>@if(Model.Q!=""||Model.Status!=""){<a class="text-link" href="/manage/@(m.Key)">清除</a>}
</form>
<div class="table-scroll"><table><caption class="sr-only">@(m.Singular)清單，共 @Model.Total 筆</caption><thead><tr><th scope="col">編號 / 名稱</th>@foreach(var key in m.Columns){<th scope="col">@(key=="Balance"?"未收餘額":m.Fields.FirstOrDefault(x=>x.Key==key)?.Label??"金額（NT$）")</th>}<th scope="col">@(m.Key=="units"?"出租狀態":"狀態")</th><th scope="col" class="right">操作</th></tr></thead><tbody>
@foreach(var row in Model.Rows){var status=Model.Occupancy.GetValueOrDefault(row.Id)??row.Status;<tr><td><a class="record-name" href="/manage/@(m.Key)/edit/@row.Id">@row.Name</a><span class="record-code">@row.Code</span></td>@foreach(var key in m.Columns){<td class="@(key is "Amount" or "Rent" or "Balance"?"numeric":"")">@Model.Cell(row,key)</td>}<td><span class="badge @(status is "啟用" or "有效" or "出租中"?"green":status is "空置中" or "草稿" or "維修中"?"amber":"gray")">@status</span></td><td class="right actions"><a href="/manage/@(m.Key)/edit/@row.Id" aria-label="編輯 @row.Name">編輯</a><a class="danger-link" href="/manage/@(m.Key)/delete/@row.Id" aria-label="刪除 @row.Name">刪除</a></td></tr>}
@if(Model.Rows.Count==0){<tr><td colspan="@(m.Columns.Length+3)"><div class="empty"><svg><use href="#i-search"/></svg><h3>目前沒有符合的資料</h3><p>試試其他搜尋條件，或新增第一筆@(m.Singular)。</p><a href="/manage/@(m.Key)/create" class="button secondary">新增@(m.Singular)</a></div></td></tr>}
</tbody></table></div>
<div class="pagination-bar"><div class="pagination-summary">共 <strong>@Model.Total</strong> 筆 <span>·</span> 顯示 @(Model.Total==0?0:(Model.Page-1)*Model.Size+1)–@(Math.Min(Model.Page*Model.Size,Model.Total)) 筆</div><form method="get" action="/manage/@(m.Key)" class="page-size"><input type="hidden" name="q" value="@Model.Q"/><input type="hidden" name="status" value="@Model.Status"/><input type="hidden" name="sort" value="@Model.Sort"/><label for="size">每頁</label><select name="size" id="size">@foreach(var size in new[]{10,20,50}){<option value="@size" selected="@(size==Model.Size)">@size 筆</option>}</select><button type="submit" class="button compact secondary">套用</button></form><nav class="pagination" aria-label="列表分頁">@if(Model.Page>1){<a href="@Link(Model.Page-1)" aria-label="上一頁">‹</a>}else{<span class="disabled">‹</span>}@for(int p=Math.Max(1,Model.Page-2);p<=Math.Min(Model.Pages,Model.Page+2);p++){<a href="@Link(p)" class="@(p==Model.Page?"current":"")" aria-current="@(p==Model.Page?"page":null)">@p</a>}@if(Model.Page<Model.Pages){<a href="@Link(Model.Page+1)" aria-label="下一頁">›</a>}else{<span class="disabled">›</span>}<span class="page-total">/ @Model.Pages 頁</span></nav></div>
</section>
