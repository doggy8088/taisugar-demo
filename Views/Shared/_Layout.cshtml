@{var active=ViewContext.RouteData.Values["module"]?.ToString()??"home";}
<!DOCTYPE html>
<html lang="zh-Hant">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#152d34"/><title>@ViewData["Title"] · 禾境物業</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body>
<svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
<symbol id="i-building" viewBox="0 0 24 24"><path d="M4 21V7l8-4v18M12 10h8v11M2 21h20M7 9v2m0 3v2m9-3v2m0 2v2M7 19v2"/></symbol>
<symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
<symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6m2 4a5 5 0 0 1 3 4v2"/></symbol>
<symbol id="i-file" viewBox="0 0 24 24"><path d="M14 3H5v18h14V8zM14 3v5h5M8 12h8M8 16h6"/></symbol>
<symbol id="i-bolt" viewBox="0 0 24 24"><path d="m13 2-9 12h7l-1 8 10-13h-8z"/></symbol>
<symbol id="i-gauge" viewBox="0 0 24 24"><path d="M4 19a10 10 0 1 1 16 0zM12 14l5-7"/><circle cx="12" cy="14" r="2"/></symbol>
<symbol id="i-wallet" viewBox="0 0 24 24"><path d="M20 7H5a2 2 0 0 1 0-4h13v4M3 5v14a2 2 0 0 0 2 2h15V7M20 11h-6v6h6"/></symbol>
<symbol id="i-receipt" viewBox="0 0 24 24"><path d="M5 3v18l3-2 4 2 4-2 3 2V3l-3 2-4-2-4 2zM8 9h8M8 13h8"/></symbol>
<symbol id="i-search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></symbol>
<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol>
</defs></svg>
<a class="skip" href="#main">跳到主要內容</a>
<button type="button" class="nav-backdrop" aria-label="關閉側邊導覽" tabindex="-1"></button>
<aside class="sidebar" id="sidebar">
<button type="button" class="sidebar-close" aria-label="關閉導覽">×</button>
<a href="/" class="brand"><span class="brand-mark"><svg><use href="#i-building"/></svg></span><span>禾境<span class="brand-en">PROPERTY MANAGEMENT</span></span></a>
<div class="workspace"><span class="workspace-avatar">禾</span><div>禾境資產管理<small>物業營運工作台</small></div><span class="workspace-chevron">⌄</span></div>
<div class="nav-heading">工作空間</div>
<nav aria-label="主要導覽"><a href="/" class="nav-item @(active=="home"?"active":"")"><svg><use href="#i-grid"/></svg>營運總覽</a>
@foreach(var item in Catalog.All){if(item.Key=="invoices"){<div class="nav-heading financial">財務管理</div>}<a href="/manage/@item.Key" class="nav-item @(active==item.Key?"active":"")"><svg><use href="#i-@item.Icon"/></svg>@item.Title</a>}
</nav>
<div class="sidebar-bottom"><span class="live-dot"></span>資料儲存於本機資料庫<small>清楚管理，安心經營。</small></div>
</aside>
<div class="app-shell">
<header class="topbar"><div class="breadcrumb"><button type="button" class="menu-toggle" aria-label="開啟導覽" aria-controls="sidebar" aria-expanded="false">☰</button>工作空間 <span>/</span><strong>@ViewData["Title"]</strong></div><div class="topbar-right"><span class="environment">內部管理系統</span><span class="avatar">管</span><span class="user-label">物業管理員</span></div></header>
<main id="main">
@if(TempData["Success"] is string success){<div class="notice success" role="status">✓ @success</div>}
@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}
@RenderBody()
<footer>禾境物業管理 <span>讓每一份資產，都井然有序。</span></footer>
</main></div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts",required:false)
</body></html>
