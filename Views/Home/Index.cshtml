@model DashboardModel
@{ViewData["Title"]="營運總覽";var max= Math.Max(1,Model.Trends.Max(x=>Math.Max(x.Expected,x.Received)));}
<section class="page-heading"><div><div class="eyebrow">YOUR PROPERTY, IN PERSPECTIVE</div><h1>營運總覽<span class="heading-dot">.</span></h1><p>掌握資產動態，讓每一個經營決策更清晰。</p></div><form method="get" class="month-select"><label for="month">統計月份</label><input type="month" id="month" name="month" value="@Model.Month.ToString("yyyy-MM")"/><button type="submit" class="button secondary compact">查詢</button></form></section>
<div class="overview-strip"><span class="live-dot"></span><strong>物業經營概況</strong><span>已管理 @Model.Assets 處資產</span><a href="/manage/assets">查看所有資產 ↗</a></div>
<section class="stats" aria-label="營運指標">
<article class="stat-card"><div class="stat-top">可出租單位<span class="stat-icon"><svg><use href="#i-building"/></svg></span></div><div class="stat-number">@Model.Units <small>間</small></div><div class="stat-bottom"><span class="subtle-pill">@Model.Occupied 間出租中</span><span>@(Model.Units-Model.Occupied) 間空置</span></div></article>
<article class="stat-card featured"><div class="stat-top">本月應收租金<span class="stat-icon"><svg><use href="#i-wallet"/></svg></span></div><div class="stat-number"><small>NT$</small> @Model.Expected.ToString("N0")</div><div class="stat-bottom">依 @Model.Month.ToString("yyyy 年 MM 月") 租金帳款統計</div></article>
<article class="stat-card"><div class="stat-top">本月實收租金<span class="stat-icon"><svg><use href="#i-receipt"/></svg></span></div><div class="stat-number"><small>NT$</small> @Model.Received.ToString("N0")</div><div class="stat-bottom"><span class="green-text">依收款日期統計</span></div></article>
<article class="stat-card"><div class="stat-top">目前逾期未收<span class="stat-icon warm"><svg><use href="#i-file"/></svg></span></div><div class="stat-number"><small>NT$</small> @Model.Outstanding.ToString("N0")</div><div class="stat-bottom"><a class="amber-text" href="/manage/invoices">查看應收帳款 →</a></div></article>
</section>
<div class="dashboard-grid"><section class="panel chart-panel"><div class="panel-heading"><div><h2>租金收支趨勢</h2><p>近六個月的應收與實收表現</p></div><div class="chart-legend"><span><i class="legend-expected"></i>應收租金</span><span><i class="legend-received"></i>實收租金</span></div></div><div class="chart" role="img" aria-label="近六個月應收與實收租金長條圖"><div class="chart-scale"><span>@((max/10000).ToString("0.#")) 萬</span><span>@((max/20000).ToString("0.#")) 萬</span><span>0</span></div><div class="chart-bars">@foreach(var t in Model.Trends){<div class="chart-group"><div class="bar-pair"><div class="bar expected" style="height:@((t.Expected/max*100).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%" title="應收 NT$ @t.Expected.ToString("N0")"></div><div class="bar received" style="height:@((t.Received/max*100).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%" title="實收 NT$ @t.Received.ToString("N0")"></div></div><span>@t.Month</span></div>}</div></div><details class="chart-data"><summary>查看圖表數據</summary><table><thead><tr><th>月份</th><th>應收（NT$）</th><th>實收（NT$）</th></tr></thead><tbody>@foreach(var t in Model.Trends){<tr><td>@t.Month</td><td>@t.Expected.ToString("N0")</td><td>@t.Received.ToString("N0")</td></tr>}</tbody></table></details></section>
<section class="panel occupancy-panel"><div class="panel-heading"><h2>空間使用概況</h2><span class="muted">出租率</span></div><div class="donut" style="--occupancy:@Model.Occupancy.ToString(System.Globalization.CultureInfo.InvariantCulture)%"><div><strong>@Model.Occupancy<small>%</small></strong><span>整體出租率</span></div></div><div class="occupancy-legend"><div><span><i class="legend-received"></i>出租中</span><strong>@Model.Occupied 間</strong></div><div><span><i class="legend-expected"></i>空置中</span><strong>@(Model.Units-Model.Occupied) 間</strong></div></div><a class="panel-link" href="/manage/units">管理出租單位 <span>→</span></a></section></div>
<div class="dashboard-bottom"><section class="panel"><div class="panel-heading"><div><h2>即將到期的租約 <span class="tiny-label">90 天內</span></h2><p>提前安排續約，讓出租不中斷</p></div><a class="text-link" href="/manage/leases">全部租約 ↗</a></div><div class="table-scroll"><table><thead><tr><th>承租戶 / 出租單位</th><th>到期日</th><th class="right">剩餘天數</th></tr></thead><tbody>@foreach(var item in Model.Expiring){<tr><td><a class="record-name" href="/manage/leases/edit/@item.Lease.Id">@item.Tenant</a><span class="record-code">@item.Unit</span></td><td>@item.Lease.EndDate.ToString("yyyy/MM/dd")</td><td class="right"><span class="badge amber">@((item.Lease.EndDate-Business.Today).Days) 天</span></td></tr>}@if(Model.Expiring.Count==0){<tr><td colspan="3" class="empty-small">未來 90 天沒有即將到期的租約。</td></tr>}</tbody></table></div></section>
<section class="panel"><div class="panel-heading"><div><h2>待追蹤帳款</h2><p>依到期日排序，優先處理逾期款項</p></div><a class="text-link" href="/manage/invoices">查看全部 ↗</a></div><div class="unpaid-list">@foreach(var item in Model.Unpaid){<a href="/manage/invoices/edit/@item.Invoice.Id" class="unpaid-item"><span class="tenant-avatar">@item.Tenant[..1]</span><div><strong>@item.Tenant</strong><small>@item.Invoice.Period.ToString("MM 月")@item.Invoice.Kind · 已逾期 @((Business.Today-item.Invoice.DueDate).Days) 天</small></div><strong class="unpaid-amount">$@item.Balance.ToString("N0")</strong></a>}@if(Model.Unpaid.Count==0){<p class="empty-small">目前沒有逾期未收帳款。</p>}</div></section></div>
